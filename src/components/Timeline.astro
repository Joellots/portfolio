---
/**
 * Vertical timeline. Used for both experience tracks and for education, so the
 * two adjacent history sections read as one system.
 */
export interface TimelineItem {
  readonly period: string;
  readonly title: string;
  readonly org: string;
  readonly summary?: string;
}

interface Props {
  /** Track name. Omitted when the timeline stands alone. */
  label?: string;
  items: readonly TimelineItem[];
  /** Heading level for entries, to fit the surrounding outline. */
  headingLevel?: 3 | 4;
}

const { label, items, headingLevel = 4 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';

/** Ongoing entries get a filled node; finished ones a hollow one. */
const isOngoing = (period: string) => /present|expected/i.test(period);
---

<div class="track">
  {label && <h3 class="track__label">{label}</h3>}
  <ol class:list={['tl', !label && 'tl--bare']} role="list">
    {
      items.map((item) => (
        <li class:list={['tl__item', isOngoing(item.period) && 'tl__item--now']}>
          <p class="tl__period">{item.period}</p>
          <Heading class="tl__role">{item.title}</Heading>
          <p class="tl__org">{item.org}</p>
          {item.summary && <p class="tl__summary">{item.summary}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .track__label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .tl {
    margin: var(--s-5) 0 0;
    padding: 0 0 0 var(--s-5);
    display: grid;
    gap: var(--s-6);
    /* The spine. */
    border-inline-start: var(--hairline) solid var(--c-rule);
  }

  .tl--bare {
    margin-block-start: 0;
    gap: var(--s-5);
  }

  .tl__item {
    position: relative;
  }

  /* Node on the spine, aligned to the period line. */
  .tl__item::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--s-5) * -1 - 0.5px);
    inset-block-start: 0.4em;
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--c-bg);
    box-shadow: inset 0 0 0 1.5px var(--c-rule-strong);
    transform: translateX(-3px);
  }

  .tl__item--now::before {
    background: var(--c-accent);
    box-shadow: none;
  }

  .tl__period {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
  }

  .tl__role {
    margin-block-start: var(--s-2);
    font-size: var(--t-h3);
    font-weight: 550;
  }

  .tl__org {
    margin-block-start: 0.1rem;
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  .tl__summary {
    margin-block-start: var(--s-3);
    max-inline-size: var(--w-text);
    font-size: var(--t-small);
    line-height: 1.7;
    color: var(--c-ink-muted);
  }

  @media (min-width: 42rem) {
    .tl {
      padding-inline-start: var(--s-6);
    }

    .tl__item::before {
      inset-inline-start: calc(var(--s-6) * -1 - 0.5px);
    }
  }
</style>
