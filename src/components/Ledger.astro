---
/**
 * Two-column record list used for experience and education: period pinned to
 * the left rail, the record itself on the right. Collapses to a single column
 * below 48rem.
 */
export interface LedgerItem {
  readonly primary: string;
  readonly secondary: string;
  readonly period: string;
  readonly place: string;
  readonly points: readonly string[];
}

interface Props {
  items: readonly LedgerItem[];
}

const { items } = Astro.props;
---

<ol class="ledger" role="list">
  {
    items.map((item) => (
      <li class="ledger__item">
        <div class="ledger__rail">
          <p class="ledger__period mono">{item.period}</p>
          <p class="ledger__place mono">{item.place}</p>
        </div>
        <div class="ledger__record">
          <h3 class="ledger__title">{item.secondary}</h3>
          <p class="ledger__org">{item.primary}</p>
          <ul class="ledger__points" role="list">
            {item.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .ledger__item {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-5);
    border-block-start: var(--hairline) solid var(--c-rule);
  }

  .ledger__item:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .ledger__period {
    color: var(--c-ink);
    font-size: var(--t-tiny);
    letter-spacing: 0.02em;
  }

  .ledger__place {
    color: var(--c-ink-faint);
    font-size: var(--t-tiny);
    margin-block-start: 0.15rem;
  }

  .ledger__title {
    font-size: var(--t-h4);
    font-weight: 550;
  }

  .ledger__org {
    color: var(--c-accent);
    font-size: 0.9375rem;
    margin-block-start: 0.1rem;
  }

  .ledger__points {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    max-inline-size: 60ch;
  }

  .ledger__points li {
    position: relative;
    padding-inline-start: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-ink-muted);
  }

  .ledger__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.66em;
    inline-size: 0.4rem;
    block-size: var(--hairline);
    background: var(--c-rule-strong);
  }

  @media (min-width: 48rem) {
    .ledger__item {
      grid-template-columns: 12rem 1fr;
      gap: var(--s-5);
      padding-block: var(--s-6);
    }
  }
</style>
