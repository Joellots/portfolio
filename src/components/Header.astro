---
import { nav, person } from '../data/site';
import { url, isCurrent } from '../lib/url';
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__mark"><Mark size={20} /></span>
      <span class="brand__name">{person.siteName}</span>
      <span class="brand__role">{person.title}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list" role="list">
        {
          nav.map((item) => {
            const current = isCurrent(item.href, pathname);
            return (
              <li>
                <a
                  class="nav__link"
                  href={url(item.href)}
                  aria-current={current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--hairline) solid var(--c-rule);
  }

  @supports not (backdrop-filter: blur(10px)) {
    .site-header {
      background: var(--c-bg);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-block-size: 3.75rem;
  }

  /* -- brand ------------------------------------------------------------- */

  .brand {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: var(--s-3);
    text-decoration: none;
    color: var(--c-ink);
  }

  .brand__mark {
    display: grid;
    grid-row: 1 / span 2;
    color: var(--c-accent);
  }

  .brand__name {
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .brand__role {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    line-height: 1.2;
  }

  .brand:hover .brand__name {
    color: var(--c-accent);
  }

  /* -- nav --------------------------------------------------------------- */

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 0.75rem);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.125rem, 1.4vw, 0.5rem);
    margin: 0;
  }

  .nav__link {
    display: inline-block;
    padding: var(--s-2) var(--s-3);
    font-size: 0.875rem;
    color: var(--c-ink-muted);
    text-decoration: none;
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--c-ink);
  }

  .nav__link[aria-current='page'] {
    color: var(--c-ink);
    box-shadow: inset 0 -2px 0 0 var(--c-accent);
  }

  @media (max-width: 30rem) {
    .brand__role {
      display: none;
    }

    .nav__link {
      padding-inline: var(--s-2);
      font-size: 0.8125rem;
    }
  }

  /*
   * Below ~416px the wordmark and four nav items cannot both fit. The mark
   * carries the identity; the name stays in the accessibility tree (visually
   * hidden rather than display:none) so the link keeps its accessible name.
   */
  @media (max-width: 26rem) {
    .brand__name {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .brand {
      column-gap: 0;
    }

    .nav__link {
      padding-inline: var(--s-1);
    }
  }
</style>
