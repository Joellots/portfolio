---
import { person, sections } from '../data/site';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="brand" href={url('/')}>{person.shortName}</a>

    <nav class="nav" aria-label="Sections">
      <ul class="nav__list" role="list">
        {
          sections.map((section) => (
            <li>
              <a class="nav__link" href={`#${section.id}`} data-nav-link={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 90%, transparent);
    backdrop-filter: blur(12px);
  }

  @supports not (backdrop-filter: blur(12px)) {
    .masthead {
      background: var(--c-bg);
    }
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-block-size: 3.5rem;
  }

  /* Wordmark only. The tile monogram lives in the favicon. */
  .brand {
    flex: none;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--c-ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--c-accent);
  }

  /* Scrolls within itself on narrow viewports rather than widening the page. */
  .nav {
    flex: 1;
    min-inline-size: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav__list {
    display: flex;
    justify-content: flex-end;
    gap: clamp(0.125rem, 1vw, 0.375rem);
    margin: 0;
  }

  /* Keep intrinsic width so the strip scrolls instead of squeezing the
     links into overlapping tap targets. */
  .nav__list > li {
    flex: none;
  }

  .nav__link {
    display: inline-block;
    padding: 0.7rem var(--s-2);
    font-size: var(--t-small);
    line-height: 1.4;
    color: var(--c-ink-faint);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius);
  }

  .nav__link:hover {
    color: var(--c-ink);
  }

  .nav__link[aria-current='true'] {
    color: var(--c-ink);
  }

  @media (max-width: 40rem) {
    .nav__list {
      justify-content: flex-start;
      padding-inline-start: var(--s-2);
    }
  }
</style>

<script>
  // Marks the section currently in view. No animation, just state.
  const links = new Map<string, HTMLAnchorElement>();
  for (const el of document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')) {
    const id = el.dataset.navLink;
    if (id) links.set(id, el);
  }

  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<string>();

    const paint = () => {
      let current: string | null = null;
      for (const [id] of links) {
        if (visible.has(id)) {
          current = id;
          break;
        }
      }
      for (const [id, link] of links) {
        if (id === current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        paint();
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    for (const target of targets) observer.observe(target);
  }
</script>
