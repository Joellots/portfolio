---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'quiet';
  external?: boolean;
  download?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'outline',
  external = false,
  download = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  class:list={['action', `action--${variant}`, className]}
  href={href}
  download={download ? '' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
</a>

<style>
  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 1.05rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .action--solid {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }

  .action--solid:hover {
    color: var(--c-accent-ink);
    background: color-mix(in srgb, var(--c-accent) 86%, var(--c-ink));
    border-color: color-mix(in srgb, var(--c-accent) 86%, var(--c-ink));
  }

  .action--outline {
    border-color: var(--c-rule-strong);
    color: var(--c-ink);
  }

  .action--outline:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .action--quiet {
    padding-inline: 0;
    color: var(--c-ink-muted);
  }

  .action--quiet:hover {
    color: var(--c-accent);
  }
</style>
