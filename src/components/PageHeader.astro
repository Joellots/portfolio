---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="shell">
    <p class="label label--accent">{eyebrow}</p>
    <h1 class="page-header__title">{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 1.6rem + 4vw, 4.5rem) clamp(2rem, 1.4rem + 3vw, 3.5rem);
    border-block-end: var(--hairline) solid var(--c-rule);
    background: linear-gradient(to bottom, var(--c-bg-sunken), var(--c-bg) 85%);
  }

  .page-header__title {
    margin-block-start: var(--s-4);
    max-inline-size: 22ch;
  }

  .page-header__lead {
    margin-block-start: var(--s-5);
    max-inline-size: 46rem;
    font-family: var(--font-serif);
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--c-ink-muted);
  }
</style>
