---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Two-digit index shown in the card gutter. */
  index: string;
  /** Larger treatment for the flagship entry. */
  feature?: boolean;
  /** Must match the surrounding document outline. */
  headingLevel?: 2 | 3;
}

const { project, index, feature = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { data } = project;
const href = url(`/projects/${project.id}`);
const headline = data.evidence.slice(0, feature ? 3 : 2);
---

<article class:list={['card', feature && 'card--feature']}>
  <div class="card__meta">
    <span class="card__index mono" aria-hidden="true">{index}</span>
    <span class="card__status">{data.status}</span>
    <span class="card__period mono">{data.period}</span>
  </div>

  <Heading class="card__title">
    <a class="card__link" href={href}>
      {data.shortTitle}
      <span class="card__arrow" aria-hidden="true">→</span>
    </a>
  </Heading>

  <p class="card__tagline">{data.tagline}</p>
  <p class="card__summary">{data.summary}</p>

  {
    headline.length > 0 && (
      <dl class="card__evidence">
        {headline.map((item) => (
          <div class="card__metric">
            <dt class="label">{item.label}</dt>
            <dd class="mono">{item.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="card__domains" role="list">
    {data.domains.map((domain) => <li>{domain}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--c-surface);
    border: var(--hairline) solid var(--c-rule);
    border-radius: var(--radius-lg);
    block-size: 100%;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .card:hover {
    border-color: var(--c-rule-strong);
    transform: translateY(-2px);
  }

  .card:focus-within {
    border-color: var(--c-accent);
  }

  /* -- meta row ---------------------------------------------------------- */

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .card__index {
    color: var(--c-accent);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
  }

  .card__status {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    padding: 0.16rem 0.45rem;
    border: var(--hairline) solid var(--c-rule);
    border-radius: var(--radius);
  }

  .card__period {
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
    margin-inline-start: auto;
  }

  /* -- body -------------------------------------------------------------- */

  .card__title {
    font-size: var(--t-h3);
    font-weight: 550;
    margin: var(--s-1) 0 0;
  }

  .card--feature .card__title {
    font-size: var(--t-h2);
  }

  .card__link {
    text-decoration: none;
    color: var(--c-ink);
  }

  /* Whole card is the hit target; the anchor keeps the accessible name. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card__link:hover {
    color: var(--c-accent);
  }

  .card__arrow {
    display: inline-block;
    margin-inline-start: 0.25em;
    color: var(--c-accent);
    transition: transform var(--dur) var(--ease);
  }

  .card:hover .card__arrow {
    transform: translateX(3px);
  }

  .card__tagline {
    color: var(--c-ink);
    font-size: var(--t-base);
    line-height: 1.45;
    max-inline-size: 46ch;
  }

  .card--feature .card__tagline {
    font-size: var(--t-lead);
    line-height: 1.35;
    letter-spacing: -0.008em;
  }

  .card__summary {
    color: var(--c-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-inline-size: 62ch;
  }

  /* -- evidence strip ---------------------------------------------------- */

  .card__evidence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin: var(--s-2) 0 0;
    padding-block-start: var(--s-4);
    border-block-start: var(--hairline) solid var(--c-rule);
  }

  .card__metric dt {
    margin-block-end: 0.25rem;
  }

  .card__metric dd {
    margin: 0;
    font-size: var(--t-h4);
    font-weight: 500;
    color: var(--c-ink);
    letter-spacing: -0.01em;
  }

  /* -- domains ----------------------------------------------------------- */

  .card__domains {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin: auto 0 0;
    padding: var(--s-4) 0 0;
    list-style: none;
  }

  .card__domains li {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    color: var(--c-ink-faint);
  }

  .card__domains li:not(:last-child)::after {
    content: '/';
    margin-inline-start: var(--s-3);
    color: var(--c-rule-strong);
  }

  @media (min-width: 48rem) {
    .card {
      padding: var(--s-6);
    }
  }
</style>
