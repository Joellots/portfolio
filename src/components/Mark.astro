---
/**
 * Identity mark: a geometric lowercase "j" with an oversized tittle.
 * One stroke and one dot — legible down to 16px, inherits currentColor.
 */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="14.6" cy="5.1" r="2.9" fill="currentColor"></circle>
  <path
    d="M14.6 11.2v5.1a4.4 4.4 0 0 1-4.4 4.4H9"
    stroke="currentColor"
    stroke-width="2.7"
    stroke-linecap="round"></path>
</svg>
