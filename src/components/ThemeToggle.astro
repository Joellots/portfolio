---
/**
 * Light/dark toggle. The no-flash initialiser lives in BaseHead so the correct
 * theme is stamped before first paint; this component only handles the click.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch colour theme">
  <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2"></path>
      <path d="M5.4 5.4 7 7M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"></path>
    </g>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
      fill="currentColor"
      stroke="none"></path>
  </svg>
  <span class="visually-hidden" data-theme-label>Switch colour theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    padding: 0;
    background: none;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    color: var(--c-ink-muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--c-ink);
    border-color: var(--c-rule);
  }

  .icon {
    grid-area: 1 / 1;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  /* Show the icon for the theme the button will switch *to*. */
  .icon--sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon--sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon--moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon--sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon--moon {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const resolved = (): 'light' | 'dark' => {
    const stamped = root.dataset.theme;
    if (stamped === 'light' || stamped === 'dark') return stamped;
    return media.matches ? 'dark' : 'light';
  };

  const sync = () => {
    const next = resolved() === 'dark' ? 'light' : 'dark';
    const text = `Switch to ${next} theme`;
    for (const el of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
      el.setAttribute('aria-label', text);
      const label = el.querySelector('[data-theme-label]');
      if (label) label.textContent = text;
    }
  };

  for (const el of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    el.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable (private mode, blocked cookies) — session only */
      }
      sync();
    });
  }

  media.addEventListener('change', sync);
  sync();
</script>
