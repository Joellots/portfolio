---
/**
 * A numbered section with a mono eyebrow and a hairline rule — the recurring
 * structural unit of the site. The index makes long pages scannable and gives
 * the layout its "instrument panel" register.
 */
interface Props {
  index: string;
  title: string;
  id?: string;
  /** Optional right-aligned link in the section header. */
  action?: { label: string; href: string };
  class?: string;
}

const { index, title, id, action, class: className } = Astro.props;
---

<section
  class:list={['section', className]}
  id={id}
  aria-labelledby={id ? `${id}-heading` : undefined}
>
  <div class="section__head">
    <span class="section__index mono" aria-hidden="true">{index}</span>
    <h2 class="section__title label" id={id ? `${id}-heading` : undefined}>{title}</h2>
    <span class="section__rule" aria-hidden="true"></span>
    {
      action && (
        <a class="section__action" href={action.href}>
          {action.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  <div class="section__body">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block-start: var(--s-section);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
  }

  .section__index {
    color: var(--c-accent);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .section__title {
    font-size: var(--t-micro);
    font-weight: 500;
    color: var(--c-ink);
    margin: 0;
  }

  .section__rule {
    flex: 1;
    block-size: var(--hairline);
    background: var(--c-rule);
    transform: translateY(-0.2em);
  }

  .section__action {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .section__action:hover {
    color: var(--c-accent);
  }
</style>
