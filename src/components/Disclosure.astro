---
/**
 * Scope disclosure. Deliberately prominent rather than a footnote: on research
 * work, the boundary of what was actually tested is part of the claim.
 */
interface Props {
  label?: string;
}

const { label = 'Scope disclosure' } = Astro.props;
---

<aside class="disclosure" aria-label={label}>
  <p class="label label--accent disclosure__label">{label}</p>
  <p class="disclosure__body"><slot /></p>
</aside>

<style>
  .disclosure {
    padding: var(--s-4) var(--s-5);
    background: var(--c-accent-wash);
    border: var(--hairline) solid var(--c-accent-line);
    border-inline-start: 3px solid var(--c-accent);
    border-radius: var(--radius);
  }

  .disclosure__label {
    margin-block-end: var(--s-2);
  }

  .disclosure__body {
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--c-ink);
    max-inline-size: 68ch;
  }
</style>
