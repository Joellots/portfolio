---
/**
 * Horizontal project browser.
 *
 * The track is a CSS scroll-snap container, so it swipes on touch and scrolls
 * with the keyboard even if the script never runs. JavaScript adds the arrow
 * buttons and dots on top of that.
 */
import type { CollectionEntry } from 'astro:content';
import Accordion from './Accordion.astro';

interface Props {
  projects: readonly CollectionEntry<'projects'>[];
  slides: readonly { readonly Content: any }[];
}

const { projects, slides } = Astro.props;
---

<div class="slider" data-slider>
  <div
    class="slider__viewport"
    data-slider-viewport
    role="group"
    aria-roledescription="carousel"
    aria-label="Projects"
    tabindex="0"
  >
    <!-- Not a list: each slide carries role="group", which would conflict
         with the listitem role an <ol> requires of its children. -->
    <div class="slider__track">
      {
        projects.map((project, i) => {
          const Content = slides[i]!.Content;
          return (
            <div
              class="slide"
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${projects.length}: ${project.data.title}`}
              data-slide
            >
              <div class="slide__inner">
                <div class="slide__head">
                  <h3 class="slide__title">{project.data.title}</h3>
                  <p class="slide__period">{project.data.period}</p>
                  {project.data.repo && (
                    <a
                      class="slide__link"
                      href={project.data.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source on GitHub <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>

                <div class="slide__body">
                  <p class="slide__purpose">{project.data.purpose}</p>
                  <p class="slide__meta">{project.data.contribution}</p>
                  {project.data.outcome && <p class="slide__meta">{project.data.outcome}</p>}
                  <Accordion label="How it works">
                    <Content />
                  </Accordion>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="slider__controls" data-slider-controls hidden>
    <button type="button" class="arrow" data-slider-prev aria-label="Previous project">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M14.5 5 8 12l6.5 7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <p class="counter mono" aria-hidden="true">
      <span data-slider-position>1</span> / {projects.length}
    </p>

    <ol class="dots" role="list">
      {
        projects.map((project, i) => (
          <li>
            <button
              type="button"
              class="dot"
              data-slider-dot={i}
              aria-label={`Show ${project.data.title}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          </li>
        ))
      }
    </ol>

    <button type="button" class="arrow" data-slider-next aria-label="Next project">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M9.5 5 16 12l-6.5 7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .slider__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Room for the focus ring. */
    margin-inline: -2px;
    padding-inline: 2px;
  }

  .slider__viewport::-webkit-scrollbar {
    display: none;
  }

  .slider__track {
    display: flex;
    gap: var(--s-6);
    margin: 0;
    padding: 0;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .slide__inner {
    display: grid;
    gap: var(--s-4);
  }

  .slide__title {
    font-size: 1.25rem;
    font-weight: 550;
  }

  .slide__period {
    margin-block-start: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
  }

  .slide__link {
    display: inline-block;
    margin-block-start: var(--s-3);
    font-size: var(--t-small);
    color: var(--c-accent);
    text-decoration-color: color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  .slide__purpose {
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
  }

  .slide__meta {
    margin-block-start: var(--s-3);
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--c-ink-muted);
  }

  @media (min-width: 48rem) {
    .slide__inner {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--s-7);
      align-items: start;
    }
  }

  /* ----------------------------------------------------------- controls */

  .slider__controls {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .slider__controls[hidden] {
    display: none;
  }

  .arrow {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--c-ink-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .arrow svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .arrow:hover:not(:disabled) {
    color: var(--c-accent);
  }

  .arrow:disabled {
    color: var(--c-rule-strong);
    cursor: default;
  }

  .counter {
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .dots {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
  }

  .dot {
    display: block;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    position: relative;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--c-rule-strong);
    transform: translate(-50%, -50%);
    transition: background-color var(--dur-fast) var(--ease);
  }

  .dot[aria-current='true']::after {
    background: var(--c-accent);
  }

  .dot:hover::after {
    background: var(--c-ink-muted);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const viewport = root.querySelector<HTMLElement>('[data-slider-viewport]');
    const controls = root.querySelector<HTMLElement>('[data-slider-controls]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!viewport || !controls || slides.length < 2) continue;

    // Controls are inert markup until the script attaches them.
    controls.hidden = false;

    let index = 0;

    const position = root.querySelector<HTMLElement>('[data-slider-position]');

    const paint = () => {
      if (position) position.textContent = String(index + 1);
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    const go = (to: number) => {
      index = Math.max(0, Math.min(slides.length - 1, to));
      viewport.scrollTo({ left: slides[index]!.offsetLeft - slides[0]!.offsetLeft });
      paint();
    };

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    // Keep the dots honest when the user swipes or scrolls directly.
    let frame = 0;
    viewport.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const origin = slides[0]!.offsetLeft;
        const positions = slides.map((slide) =>
          Math.abs(slide.offsetLeft - origin - viewport.scrollLeft)
        );
        index = positions.indexOf(Math.min(...positions));
        paint();
      });
    });

    paint();
  }
</script>
