---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import IconLink from '../components/IconLink.astro';
import {
  person,
  heroIntro,
  about,
  interests,
  experience,
  publications,
  education,
  links,
} from '../data/site';
import { url, absoluteUrl } from '../lib/url';
import portrait from '../assets/images/joel-portrait.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  projects.map(async (project) => ({ project, Content: (await render(project)).Content }))
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.fullName,
  jobTitle: person.title,
  description: person.metaDescription,
  url: absoluteUrl('/', Astro.site),
  image: absoluteUrl('/og/joel-okore-og.jpg', Astro.site),
  sameAs: links.filter((link) => link.icon !== 'email').map((link) => link.href),
  knowsAbout: interests.map((interest) => interest.name),
  alumniOf: education.map((study) => ({ '@type': 'CollegeOrUniversity', name: study.org })),
};
---

<BaseLayout
  title={`${person.shortName} Okore · ${person.title}`}
  description={person.metaDescription}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ============================================================= hero -->
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__text">
        <h1 class="hero__name">{person.fullName}</h1>
        <p class="hero__role">{person.title}</p>
        <p class="hero__intro">{heroIntro}</p>

        <div class="hero__actions">
          <ul class="iconrow" role="list">
            {
              links.map((link) => (
                <li>
                  <IconLink href={link.href} label={link.label} icon={link.icon} />
                </li>
              ))
            }
          </ul>
          <a class="cv" href={url(person.cvPath)} download>CV (PDF)</a>
        </div>
      </div>

      <div class="hero__portrait">
        <Image
          src={portrait}
          alt={`Portrait photograph of ${person.fullName}.`}
          widths={[320, 460, 640, 880]}
          sizes="(min-width: 56rem) 20rem, (min-width: 34rem) 40vw, 68vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          quality={84}
        />
      </div>
    </div>
  </section>

  <div class="shell">
    <!-- ========================================================== about -->
    <section id="about" class="section" aria-labelledby="about-title">
      <h2 id="about-title" class="section__title">About</h2>
      <div class="section__body">
        <div class="prose">
          {about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <!-- ====================================================== interests -->
    <section id="interests" class="section" aria-labelledby="interests-title">
      <h2 id="interests-title" class="section__title">Research interests</h2>
      <div class="section__body">
        <dl class="interests">
          {
            interests.map((interest) => (
              <div class="interests__row">
                <dt>{interest.name}</dt>
                <dd>{interest.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- =========================================================== work -->
    <section id="work" class="section" aria-labelledby="work-title">
      <h2 id="work-title" class="section__title">Selected work</h2>
      <div class="section__body">
        <ol class="work" role="list">
          {
            rendered.map(({ project, Content }) => (
              <li class="project">
                <div class="project__head">
                  <h3 class="project__title">{project.data.title}</h3>
                  <span class="project__period">{project.data.period}</span>
                </div>

                <p class="project__purpose">{project.data.purpose}</p>
                <p class="project__meta">{project.data.contribution}</p>
                {project.data.outcome && <p class="project__outcome">{project.data.outcome}</p>}

                {project.data.repo && (
                  <p class="project__link">
                    <a href={project.data.repo} target="_blank" rel="noopener noreferrer">
                      Source on GitHub
                    </a>
                  </p>
                )}

                <Accordion label="How it works">
                  <Content />
                </Accordion>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ===================================================== experience -->
    <section id="experience" class="section" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section__title">Experience</h2>
      <div class="section__body">
        <ol class="entries" role="list">
          {
            experience.map((role) => (
              <li class="entry">
                <p class="entry__period">{role.period}</p>
                <div>
                  <h3 class="entry__title">{role.title}</h3>
                  <p class="entry__org">{role.org}</p>
                  <p class="entry__summary">{role.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- =================================================== publications -->
    <section id="publications" class="section" aria-labelledby="publications-title">
      <h2 id="publications-title" class="section__title">Publications</h2>
      <div class="section__body">
        <ol class="entries" role="list">
          {
            publications.map((pub) => (
              <li class="entry">
                <p class="entry__period">
                  {pub.venue} {pub.year}
                </p>
                <div>
                  <h3 class="entry__title">{pub.title}</h3>
                  <p class="entry__summary">{pub.plain}</p>
                  <p class="project__link">
                    <a href={pub.doi} target="_blank" rel="noopener noreferrer">
                      Read the paper (DOI)
                    </a>
                  </p>
                  <Accordion label="What the paper found">
                    {pub.details.map((detail) => (
                      <p>{detail}</p>
                    ))}
                    <p class="authors">{pub.authors}</p>
                  </Accordion>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ====================================================== education -->
    <section id="education" class="section" aria-labelledby="education-title">
      <h2 id="education-title" class="section__title">Education</h2>
      <div class="section__body">
        <ol class="entries" role="list">
          {
            education.map((study) => (
              <li class="entry">
                <p class="entry__period">{study.period}</p>
                <div>
                  <h3 class="entry__title">{study.degree}</h3>
                  <p class="entry__org">{study.org}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ======================================================== contact -->
    <section id="contact" class="section" aria-labelledby="contact-title">
      <h2 id="contact-title" class="section__title">Contact</h2>
      <div class="section__body">
        <p class="contact__lead">
          The quickest way to reach me is email. I am glad to talk about research, collaboration, or
          anything on this page.
        </p>
        <ul class="iconrow" role="list">
          {
            links.map((link) => (
              <li>
                <IconLink href={link.href} label={link.label} icon={link.icon} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero */

  .hero__inner {
    display: grid;
    gap: var(--s-7);
    padding-block: clamp(2.5rem, 1.4rem + 5vw, 5.5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
    align-items: center;
  }

  .hero__name {
    max-inline-size: 12ch;
  }

  .hero__role {
    margin-block-start: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: 0.06em;
    color: var(--c-accent);
  }

  .hero__intro {
    margin-block-start: var(--s-5);
    max-inline-size: 34rem;
    font-family: var(--font-serif);
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--c-ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-block-start: var(--s-6);
    margin-inline-start: calc(var(--s-3) * -1);
  }

  .cv {
    font-size: var(--t-small);
    color: var(--c-ink-muted);
    text-decoration-color: var(--c-rule-strong);
  }

  .hero__portrait {
    max-inline-size: 17rem;
    padding: 0.5rem;
    background: var(--c-raised);
    border-radius: 5px;
  }

  .hero__portrait :global(img) {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--c-raised);
  }

  @media (min-width: 34rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-8);
    }

    .hero__portrait {
      inline-size: clamp(11rem, 26vw, 17rem);
      max-inline-size: none;
    }
  }

  /* --------------------------------------------------------- sections */

  .section {
    padding-block-start: var(--s-section);
    scroll-margin-top: 4.5rem;
  }

  .section__title {
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-ink-faint);
  }

  .section__body {
    margin-block-start: var(--s-5);
  }

  @media (min-width: 56rem) {
    .section {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--s-7);
    }

    .section__title {
      padding-block-start: 0.35rem;
    }

    .section__body {
      margin-block-start: 0;
    }
  }

  /* -------------------------------------------------------- interests */

  .interests {
    margin: 0;
    display: grid;
    gap: var(--s-4);
    max-inline-size: 40rem;
  }

  .interests__row dt {
    font-size: var(--t-base);
    font-weight: 500;
    color: var(--c-ink);
  }

  .interests__row dd {
    margin: 0.15rem 0 0;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--c-ink-muted);
  }

  /* ------------------------------------------------------------- work */

  .work {
    display: grid;
    gap: var(--s-8);
    margin: 0;
  }

  .project__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
  }

  .project__title {
    font-size: 1.25rem;
    font-weight: 550;
  }

  .project__period,
  .entry__period {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
  }

  .project__period {
    white-space: nowrap;
  }

  .project__purpose {
    margin-block-start: var(--s-3);
    max-inline-size: var(--w-text);
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
  }

  .project__meta,
  .project__outcome {
    margin-block-start: var(--s-3);
    max-inline-size: var(--w-text);
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--c-ink-muted);
  }

  .project__link {
    margin-block-start: var(--s-3);
    font-size: var(--t-small);
  }

  .project__link a {
    color: var(--c-accent);
    text-decoration-color: color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  /* ---------------------------------------- experience / pubs / study */

  .entries {
    display: grid;
    gap: var(--s-6);
    margin: 0;
  }

  .entry {
    display: grid;
    gap: var(--s-1);
  }

  .entry__period {
    padding-block-start: 0.2rem;
  }

  .entry__title {
    font-size: var(--t-h3);
    font-weight: 550;
  }

  .entry__org {
    margin-block-start: 0.1rem;
    font-size: var(--t-small);
    color: var(--c-ink-muted);
  }

  .entry__summary {
    margin-block-start: var(--s-2);
    max-inline-size: var(--w-text);
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--c-ink-muted);
  }

  .authors {
    font-family: var(--font-sans) !important;
    font-size: var(--t-micro) !important;
    color: var(--c-ink-faint) !important;
  }

  @media (min-width: 42rem) {
    .entry {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: var(--s-5);
    }
  }

  /* ---------------------------------------------------------- contact */

  .contact__lead {
    max-inline-size: var(--w-text);
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--c-ink-muted);
  }

  .iconrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: var(--s-4) 0 0 calc(var(--s-3) * -1);
  }

  .hero__actions .iconrow {
    margin: 0;
  }
</style>
