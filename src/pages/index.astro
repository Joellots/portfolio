---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import IconLink from '../components/IconLink.astro';
import Portrait from '../components/Portrait.astro';
import SkillIcon from '../components/SkillIcon.astro';
import ExperienceTabs from '../components/ExperienceTabs.astro';
import ProjectSlider from '../components/ProjectSlider.astro';
import {
  person,
  greeting,
  keywords,
  about,
  interests,
  skills,
  experience,
  publications,
  education,
  links,
} from '../data/site';
import { absoluteUrl } from '../lib/url';
import portrait from '../assets/images/joel-portrait.jpg';
import portraitContact from '../assets/images/joel-portrait-contact.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
/*
 * Split into two independent stacks so an open disclosure grows only its own
 * column. A two-column grid over one list would share rows, leaving a gap
 * beside whichever row was expanded.
 */
const skillStacks = [
  skills.slice(0, Math.ceil(skills.length / 2)),
  skills.slice(Math.ceil(skills.length / 2)),
];

const academic = education.map((study) => ({
  period: study.period,
  title: study.degree,
  org: study.org,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.fullName,
  jobTitle: person.title,
  description: person.metaDescription,
  url: absoluteUrl('/', Astro.site),
  image: absoluteUrl('/og/joel-okore-og.jpg', Astro.site),
  sameAs: links.filter((link) => link.icon !== 'email').map((link) => link.href),
  knowsAbout: interests,
  alumniOf: education.map((study) => ({ '@type': 'CollegeOrUniversity', name: study.org })),
};
---

<BaseLayout
  title={`${person.shortName} Okore · ${person.title}`}
  description={person.metaDescription}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ============================================================= hero -->
  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__text">
        <h1 class="hero__greeting">{greeting}</h1>
        <p class="hero__role">{person.title}</p>

        <ul class="hero__keywords" role="list">
          {keywords.map((keyword) => <li>{keyword}</li>)}
        </ul>

        <div class="hero__actions">
          <ul class="iconrow" role="list">
            {
              links.map((link) => (
                <li>
                  <IconLink href={link.href} label={link.label} icon={link.icon} />
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <Portrait
        class="hero__portrait"
        src={portrait}
        alt={`Portrait photograph of ${person.fullName}.`}
        variant="a"
        ratio="4 / 5"
        widths={[320, 460, 640, 880]}
        sizes="(min-width: 56rem) 19rem, (min-width: 34rem) 38vw, 62vw"
        eager
      />
    </div>
  </section>

  <div class="shell">
    <!-- ========================================================== about -->
    <section id="about" class="section" aria-labelledby="about-title">
      <h2 id="about-title" class="section__title">About</h2>
      <div class="section__body">
        <div class="prose">
          {about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <!-- ====================================================== interests -->
    <section id="interests" class="section" aria-labelledby="interests-title">
      <h2 id="interests-title" class="section__title">Research interests</h2>
      <div class="section__body">
        <ul class="chips" role="list">
          {interests.map((interest) => <li class="chip">{interest}</li>)}
        </ul>
      </div>
    </section>

    <!-- ========================================================= skills -->
    <section id="skills" class="section" aria-labelledby="skills-title">
      <h2 id="skills-title" class="section__title">Skills</h2>
      <div class="section__body">
        <div class="skills">
          {
            skillStacks.map((stack) => (
              <div class="skills__stack">
                {stack.map((group) => (
                  <Accordion label={group.name} variant="row" headingLevel={3}>
                    <SkillIcon slot="icon" name={group.icon} />
                    <ul class="chips chips--quiet" role="list">
                      {group.items.map((item) => (
                        <li class="chip">{item}</li>
                      ))}
                    </ul>
                  </Accordion>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ======================================================= projects -->
    <section id="projects" class="section" aria-labelledby="projects-title">
      <h2 id="projects-title" class="section__title">Projects</h2>
      <div class="section__body">
        <ProjectSlider projects={projects} />
      </div>
    </section>

    <!-- ===================================================== experience -->
    <section id="experience" class="section" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section__title">Experience</h2>
      <div class="section__body">
        <ExperienceTabs academic={academic} professional={experience} />
      </div>
    </section>

    <!-- =================================================== publications -->
    <section id="publications" class="section" aria-labelledby="publications-title">
      <h2 id="publications-title" class="section__title">Publications</h2>
      <div class="section__body">
        <ol class="entries" role="list">
          {
            publications.map((pub) => (
              <li class="entry">
                <p class="entry__period">
                  {pub.venue} {pub.year}
                </p>
                <div>
                  <h3 class="entry__title">{pub.title}</h3>
                  <p class="entry__summary">{pub.plain}</p>
                  <p class="entry__link">
                    <a href={pub.doi} target="_blank" rel="noopener noreferrer">
                      Read the paper (DOI)
                    </a>
                  </p>
                  <Accordion label="What the paper found">
                    {pub.details.map((detail) => (
                      <p>{detail}</p>
                    ))}
                    <p class="authors">{pub.authors}</p>
                  </Accordion>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ======================================================== contact -->
    <section id="contact" class="section" aria-labelledby="contact-title">
      <h2 id="contact-title" class="section__title">Contact</h2>
      <div class="section__body contact">
        <div>
          <p class="contact__lead">
            Telegram is the quickest way to reach me, and email works just as well. I am glad to
            talk about research, collaboration, or anything on this page.
          </p>
          <ul class="iconrow" role="list">
            {
              links.map((link) => (
                <li>
                  <IconLink href={link.href} label={link.label} icon={link.icon} />
                </li>
              ))
            }
          </ul>
        </div>
        <Portrait
          class="contact__portrait"
          src={portraitContact}
          alt={`${person.fullName}, photographed outdoors.`}
          variant="b"
          ratio="4 / 5"
          widths={[240, 360, 520, 720]}
          sizes="(min-width: 40rem) 11.5rem, 10rem"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero */

  .hero__inner {
    display: grid;
    gap: var(--s-7);
    padding-block: clamp(2.5rem, 1.4rem + 5vw, 5.5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
    align-items: center;
  }

  .hero__greeting {
    max-inline-size: 12ch;
  }

  .hero__role {
    margin-block-start: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: 0.06em;
    color: var(--c-accent);
  }

  .hero__keywords {
    display: flex;
    flex-wrap: wrap;
    margin-block-start: var(--s-5);
    max-inline-size: 32rem;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--c-ink-muted);
  }

  .hero__keywords li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.5em;
    color: var(--c-accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-block-start: var(--s-6);
    margin-inline-start: calc(var(--s-3) * -1);
  }

  /*
   * A definite width, not max-inline-size: `margin-inline: auto` stops a grid
   * item stretching, so the wrapper would size to fit-content of the image —
   * zero until the image loads, which collapses the reserved box and shifts
   * the whole page down when it arrives.
   */
  .hero :global(.hero__portrait) {
    inline-size: min(15rem, 100%);
    margin-inline: auto;
  }

  @media (min-width: 34rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-8);
    }

    .hero :global(.hero__portrait) {
      inline-size: clamp(10.5rem, 25vw, 16rem);
      max-inline-size: none;
      margin-inline: 0;
    }
  }

  /* --------------------------------------------------------- sections */

  .section {
    padding-block-start: var(--s-section);
    scroll-margin-top: 4.5rem;
  }

  .section__title {
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--c-ink-faint);
  }

  .section__body {
    margin-block-start: var(--s-5);
  }

  @media (min-width: 56rem) {
    .section {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--s-7);
    }

    .section__title {
      padding-block-start: 0.35rem;
    }

    .section__body {
      margin-block-start: 0;
    }
  }

  /* ---------------------------------------------------- chips (shared) */

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }

  .chip {
    padding: 0.45rem 0.85rem;
    background: var(--c-raised);
    border-radius: 100px;
    font-size: var(--t-small);
    line-height: 1.35;
    color: var(--c-ink);
  }

  .chips--quiet .chip {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-ink-muted);
  }

  /* --------------------------------------------------------- skills */

  .skills {
    display: grid;
    gap: 0 var(--s-7);
  }

  .skills__stack {
    display: grid;
    align-content: start;
  }

  @media (min-width: 48rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --------------------------------------------------- publications */

  .entries {
    display: grid;
    gap: var(--s-6);
    margin: 0;
  }

  .entry {
    display: grid;
    gap: var(--s-1);
  }

  .entry__period {
    padding-block-start: 0.2rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--c-ink-faint);
  }

  .entry__title {
    font-size: var(--t-h3);
    font-weight: 550;
  }

  .entry__summary {
    margin-block-start: var(--s-3);
    max-inline-size: var(--w-text);
    font-size: var(--t-base);
    line-height: 1.7;
    color: var(--c-ink-muted);
  }

  .entry__link {
    margin-block-start: var(--s-3);
    font-size: var(--t-small);
  }

  .entry__link a {
    color: var(--c-accent);
    text-decoration-color: color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  .authors {
    font-family: var(--font-sans) !important;
    font-size: var(--t-micro) !important;
    color: var(--c-ink-faint) !important;
  }

  @media (min-width: 42rem) {
    .entry {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      gap: var(--s-5);
    }
  }

  /* ---------------------------------------------------------- contact */

  .contact {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }

  /*
   * Portrait renders its own root element, so these sizing rules have to be
   * global to reach it — a component's scoped styles do not apply to markup
   * emitted by a child component.
   */
  .contact :global(.contact__portrait) {
    inline-size: 10rem;
  }

  @media (min-width: 40rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-8);
    }

    .contact :global(.contact__portrait) {
      inline-size: 11.5rem;
    }
  }

  .contact__lead {
    max-inline-size: var(--w-text);
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--c-ink-muted);
  }

  .iconrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: var(--s-4) 0 0 calc(var(--s-3) * -1);
  }

  .hero__actions .iconrow {
    margin: 0;
  }
</style>
