---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Head back to the homepage for work, publications and contact details."
  path="/404"
>
  <div class="shell notfound">
    <p class="eyebrow">Error 404</p>
    <h1>This page does not exist</h1>
    <p class="notfound__body">
      The link you followed does not match anything here. It may have been renamed, or mistyped.
    </p>
    <p class="notfound__back"><a href={url('/')}>Back to the homepage</a></p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
    max-inline-size: 34rem;
  }

  .notfound h1 {
    margin-block-start: var(--s-4);
  }

  .notfound__body {
    margin-block-start: var(--s-5);
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
    color: var(--c-ink-muted);
  }

  .notfound__back {
    margin-block-start: var(--s-6);
  }

  .notfound__back a {
    color: var(--c-accent);
  }
</style>
