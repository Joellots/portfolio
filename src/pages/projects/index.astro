---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { url } from '../../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const description =
  'Case studies from Joel Okore’s security research: encrypted-traffic detection, explainable machine learning, memory forensics automation and streaming analytics.';
---

<BaseLayout title="Projects" description={description} path="/projects">
  <PageHeader
    eyebrow={`${projects.length} case studies`}
    title="Projects"
    lead="Each case study sets out the problem, what I did, how the system works, what the evidence actually supports — and where it stops. Figures come from the research evaluations they describe; nothing here has been through an operational deployment."
  />

  <div class="shell">
    <ol class="grid" role="list">
      {
        projects.map((project) => (
          <li class:list={['grid__cell', project.data.featured && 'grid__cell--wide']}>
            <ProjectCard
              project={project}
              index={String(project.data.order).padStart(2, '0')}
              feature={project.data.order === 1}
              headingLevel={2}
            />
          </li>
        ))
      }
    </ol>

    <p class="note">
      More engineering work — laboratory materials, tooling and smaller experiments — lives on
      <a href="https://github.com/Joellots" rel="noopener noreferrer" target="_blank">GitHub</a>.
      For dates, roles and credentials in list form, see <a href={url('/about')}>about</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-8) 0 0;
    padding: 0;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid__cell--wide:first-child {
      grid-column: 1 / -1;
    }
  }

  .note {
    margin-block: var(--s-7) 0;
    padding-block-start: var(--s-5);
    border-block-start: var(--hairline) solid var(--c-rule);
    font-size: 0.9375rem;
    color: var(--c-ink-muted);
    max-inline-size: 52ch;
  }
</style>
