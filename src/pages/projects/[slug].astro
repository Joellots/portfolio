---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclosure from '../../components/Disclosure.astro';
import EvidenceTable from '../../components/EvidenceTable.astro';
import TagList from '../../components/TagList.astro';
import { person } from '../../data/site';
import { url, absoluteUrl } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

// Only the section headings authored in the case-study template.
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: data.title,
  abstract: data.summary,
  author: { '@type': 'Person', name: person.fullName },
  url: absoluteUrl(`/projects/${project.id}`, Astro.site),
  keywords: [...data.domains, ...data.stack].join(', '),
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={data.shortTitle}
  description={data.seoDescription ?? data.summary}
  path={`/projects/${project.id}`}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="case">
    <!-- ========================================================= header -->
    <header class="case__header">
      <div class="shell">
        <a class="case__back mono" href={url('/projects')}>
          <span aria-hidden="true">←</span> All projects
        </a>

        <p class="case__meta">
          <span class="case__status">{data.status}</span>
          <span class="mono case__kind">{data.kind}</span>
          <span class="mono case__period">{data.period}</span>
        </p>

        <h1 class="case__title">{data.title}</h1>
        <p class="case__tagline">{data.tagline}</p>
      </div>
    </header>

    <div class="shell case__grid">
      <!-- ========================================================= rail -->
      <aside class="rail" aria-label="Project details">
        <div class="rail__sticky">
          <TagList items={data.stack} label="Technology" />

          <div class="rail__block">
            <TagList items={data.domains} label="Domains" variant="inline" />
          </div>

          {
            data.links.length > 0 && (
              <div class="rail__block">
                <h2 class="label">Links</h2>
                <ul class="rail__links" role="list">
                  {data.links.map((link) => (
                    <li>
                      <a href={link.href} rel="noopener noreferrer" target="_blank">
                        {link.label}
                      </a>
                      {link.note && <span class="rail__note">{link.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <nav class="rail__block rail__toc" aria-label="On this page">
            <h2 class="label">On this page</h2>
            <ul role="list">
              {
                toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </aside>

      <!-- ========================================================= body -->
      <div class="case__main">
        {data.disclosure && <Disclosure>{data.disclosure}</Disclosure>}

        {
          data.evidence.length > 0 && (
            <div class="case__evidence">
              <EvidenceTable items={data.evidence} caption="Measured results" />
            </div>
          )
        }

        <div class="case__body">
          <Content />
        </div>
      </div>
    </div>

    <!-- ====================================================== pagination -->
    <nav class="shell case__pager" aria-label="Project navigation">
      {
        prev ? (
          <a class="case__pager-link" href={url(`/projects/${prev.id}`)} rel="prev">
            <span class="label">Previous</span>
            <span class="case__pager-title">{prev.data.shortTitle}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            class="case__pager-link case__pager-link--next"
            href={url(`/projects/${next.id}`)}
            rel="next"
          >
            <span class="label">Next</span>
            <span class="case__pager-title">{next.data.shortTitle}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  /* ----------------------------------------------------------- header */

  .case__header {
    padding-block: clamp(1.75rem, 1.2rem + 2.4vw, 3rem) clamp(2rem, 1.4rem + 3vw, 3.5rem);
    border-block-end: var(--hairline) solid var(--c-rule);
    background: linear-gradient(to bottom, var(--c-bg-sunken), var(--c-bg) 85%);
  }

  .case__back {
    display: inline-block;
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    text-decoration: none;
  }

  .case__back:hover {
    color: var(--c-accent);
  }

  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-5);
  }

  .case__status {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent);
    padding: 0.16rem 0.45rem;
    border: var(--hairline) solid var(--c-accent-line);
    border-radius: var(--radius);
    background: var(--c-accent-wash);
  }

  .case__kind,
  .case__period {
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }

  .case__title {
    margin-block-start: var(--s-4);
    max-inline-size: 24ch;
  }

  .case__tagline {
    margin-block-start: var(--s-4);
    max-inline-size: 44rem;
    font-family: var(--font-serif);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--c-ink-muted);
  }

  /* ------------------------------------------------------------- grid */

  .case__grid {
    display: grid;
    gap: var(--s-7);
    padding-block-start: var(--s-7);
  }

  .case__evidence {
    margin-block-start: var(--s-6);
  }

  .case__evidence:first-child {
    margin-block-start: 0;
  }

  /* ------------------------------------------------------------- rail */

  .rail {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    padding-block-end: var(--s-5);
    border-block-end: var(--hairline) solid var(--c-rule);
  }

  .rail__sticky {
    display: grid;
    gap: var(--s-5);
  }

  .rail__block h2 {
    margin-block-end: var(--s-3);
  }

  .rail__links {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }

  .rail__links a {
    font-size: 0.875rem;
  }

  .rail__note {
    display: block;
    font-size: var(--t-tiny);
    color: var(--c-ink-faint);
  }

  .rail__toc ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    border-inline-start: var(--hairline) solid var(--c-rule);
  }

  .rail__toc li {
    padding-inline-start: var(--s-3);
  }

  .rail__toc a {
    font-size: 0.875rem;
    color: var(--c-ink-muted);
    text-decoration: none;
  }

  .rail__toc a:hover {
    color: var(--c-accent);
  }

  @media (min-width: 62rem) {
    .case__grid {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--s-9);
      align-items: start;
    }

    .rail {
      order: 2;
      border-block-end: 0;
      padding-block-end: 0;
    }

    .case__main {
      order: 1;
    }

    .case__grid {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }

    .rail__sticky {
      position: sticky;
      top: 5.5rem;
    }
  }

  /* ------------------------------------------------------------- body */

  .case__body {
    margin-block-start: var(--s-7);
    max-inline-size: var(--w-text);
  }

  .case__body :global(h2) {
    margin-block: var(--s-8) var(--s-4);
    padding-block-start: var(--s-4);
    border-block-start: var(--hairline) solid var(--c-rule);
    font-size: var(--t-h3);
    font-weight: 550;
    scroll-margin-top: 6rem;
  }

  .case__body :global(h2:first-child) {
    margin-block-start: 0;
    padding-block-start: 0;
    border-block-start: 0;
  }

  .case__body :global(h3) {
    margin-block: var(--s-6) var(--s-3);
    font-size: var(--t-h4);
    font-weight: 550;
  }

  .case__body :global(p),
  .case__body :global(li) {
    font-family: var(--font-serif);
    font-size: var(--t-body);
    line-height: var(--lh-prose);
  }

  .case__body :global(p) {
    margin-block-start: var(--s-4);
  }

  .case__body :global(strong) {
    font-weight: 650;
    color: var(--c-ink);
  }

  .case__body :global(em) {
    font-style: italic;
  }

  .case__body :global(ul) {
    margin-block-start: var(--s-4);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }

  .case__body :global(ul li) {
    position: relative;
    padding-inline-start: 1.25rem;
  }

  .case__body :global(ul li::before) {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.72em;
    inline-size: 0.5rem;
    block-size: var(--hairline);
    background: var(--c-accent);
  }

  .case__body :global(a) {
    color: var(--c-accent);
    text-decoration-color: var(--c-accent-line);
  }

  /* --------------------------------------------------------- pagination */

  .case__pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-block-start: var(--s-9);
    padding-block-start: var(--s-5);
    border-block-start: var(--hairline) solid var(--c-rule);
  }

  .case__pager-link {
    display: grid;
    gap: var(--s-2);
    text-decoration: none;
    max-inline-size: 18rem;
  }

  .case__pager-link--next {
    text-align: right;
    margin-inline-start: auto;
  }

  .case__pager-title {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .case__pager-link:hover .case__pager-title {
    color: var(--c-accent);
  }
</style>
