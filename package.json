{
  "name": "joel-okore-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site for Okore Joel Chidike — Security Engineer and Researcher.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,css,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,css,md,json,yml,yaml}\"",
    "audit:output": "node scripts/verify-output.mjs",
    "verify": "npm run format:check && npm run check && npm run build && npm run audit:output"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
